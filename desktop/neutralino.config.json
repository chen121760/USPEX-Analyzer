{
  "applicationId": "com.uspex.analyzer",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "modes": {
    "window": {
      "title": "USPEX Analyzer",
      "width": 1280,
      "height": 800,
      "minWidth": 1024,
      "minHeight": 768,
      "resizable": true,
      "maximize": false,
      "icon": "/favicon.ico"
    }
  },
  "cli": {
    "binaryName": "uspex-analyzer",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "5.5.0",
    "clientVersion": "5.5.0"
  }
}
